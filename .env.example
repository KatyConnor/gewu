# 格物平台生产环境变量配置
# 复制此文件为 .env 并填写实际值

# ===== MySQL 数据库配置 =====
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_PASSWORD=your_secure_app_password_here
MYSQL_DATABASE=gewu_prod

# ===== pgvector 数据库配置 =====
POSTGRES_PASSWORD=your_wenshi_db_password_here

# ===== JWT 配置 =====
JWT_SECRET=your_jwt_secret_at_least_256_bits_long
JWT_EXPIRATION=1800
JWT_REFRESH_EXPIRATION=604800

# ===== 国密配置 =====
SM4_KEY=your_sm4_key_128bit_hex
SM2_PUBLIC_KEY=your_sm2_public_key_hex
SM2_PRIVATE_KEY=your_sm2_private_key_hex

# ===== Redis/DragonflyDB 配置 =====
REDIS_PASSWORD=your_redis_password_here

# ===== RocketMQ 配置 =====
ROCKETMQ_NAMESERVER=rocketmq-nameserver:9876

# ===== AI 网关配置 =====
AI_GATEWAY_URL=http://ai-gateway:8081
AI_PROVIDER=qwen
AI_API_KEY=your_ai_api_key_here

# ===== 应用配置 =====
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_LEVEL=INFO

# ===== 监控配置 =====
PROMETHEUS_ENABLED=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# ===== 国密 SM4 加密密钥（32位十六进制 = 16字节） 敏感数据加密密钥 生产环境必须替换 =====
GEWU_CRYPTO_API_KEY_SECRET=13b4a0eab2f1f1093f87d0552fddca1f

# ===== 沙箱服务内部 API 密钥（interface 与 sandbox 共享；生产必须替换，prod profile 禁止历史弱默认值） =====
GEWU_INTERNAL_API_KEY=generate_a_random_secret_here
