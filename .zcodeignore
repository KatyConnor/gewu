# 格物平台 - Git 忽略文件

# ==================== Java ====================
*.class
*.jar
*.war
*.ear
*.nar

# AI 模型文件（大文件，不入库）
models/*.onnx
models/*.onnx_data
models/*.safetensors
models/*.bin
models/tokenizer.json
models/config.json
models/*.gguf

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==================== IDE ====================
.idea/
*.iws
*.iml
*.ipr
.vscode/
