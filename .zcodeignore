.dockerignore

# ==================== Node.js ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================== Build ====================
dist/
# build/ 为 Java 模块产物规则；gewu-desktop/build 存放入库资源（icon）与产物（jre）
build/
!gewu-desktop/build/
gewu-desktop/build/jre/
out/

# ==================== Environment ====================
.env
.env.local
.env.*.local

# ==================== Project Specific ====================
# 本机启停脚本（scripts/gewu-ctl.sh）的 PID 文件
run/
# 本地配置文件
application-local.yml
application-local.properties

# 临时文件
tmp/
temp/

# Next.js 构建产物（gewu-admin-web）
.next/

# 私服备份（S4 旧表退役备份等，不入库）
deploy/backup/

# gewu-desktop 运行时数据与产物（Phase 1）
gewu-desktop-runtime/data/
gewu-desktop-runtime/workspace/
gewu-desktop/release/
gewu-desktop/workspace/

