# EditorConfig — 统一编辑器格式
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_size = 2

[*.{json,jsonc,json5,yaml,yml}]
indent_size = 2

[*.{css,scss,less,html,vue,svelte}]
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.rs]
indent_size = 4

[*.{c,cpp,cc,h,hpp}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 4

[Dockerfile]
indent_size = 4
