  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=1.20.0",
    "prismjs": ">=1.29.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
