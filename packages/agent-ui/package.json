    "./chat-ui/plan": "./src/chat-ui/plan/index.ts",
    "./chat-ui/sidebar": "./src/chat-ui/sidebar/index.ts",
    "./chat-ui/page": "./src/chat-ui/page/index.ts",
    "./chat-ui/filepanel": "./src/chat-ui/filepanel/index.ts",
