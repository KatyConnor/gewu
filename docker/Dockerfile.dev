# 格物平台开发沙箱基础镜像
# 预装: git, openssh, jdk-21, maven, node-20, python-3, go+dlv, gdb, rustc/cargo
FROM eclipse-temurin:21-jdk-jammy

# 安装开发工具链
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    vim \
    curl \
    wget \
    unzip \
    tar \
    maven \
    gradle \
    python3 \
    python3-pip \
    nodejs \
    npm \
    gdb \
    rustc \
    cargo \
    && rm -rf /var/lib/apt/lists/*

# Go 工具链 + delve 调试器（apt golang-go 版本过旧无法编译新版 delve，取官方 tarball）
RUN curl -fsSL https://go.dev/dl/go1.22.10.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH
RUN go install github.com/go-delve/delve/cmd/dlv@v1.22.1

# 时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 工作目录
WORKDIR /workspace

# SSH 配置目录（运行时由 Volume 挂载或 Docker cp 写入）
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

# Git 全局配置
RUN git config --global user.email "dev@gewu.local" \
    && git config --global user.name "Gewu Dev" \
    && git config --global init.defaultBranch main \
    && git config --global safe.directory '*'

# 保持容器运行
CMD ["sleep", "infinity"]
