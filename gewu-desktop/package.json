{
  "name": "gewu-desktop",
  "version": "0.1.0",
  "description": "格物平台桌面客户端（Electron）",
  "main": "electron/main.js",
  "private": true,
  "author": "gewu-platform",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist": "pnpm build:ui && electron-builder --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.gewu.platform.desktop",
    "productName": "Gewu Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gewu Desktop"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "gewu-platform"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "@gewu/agent-ui": "workspace:*",
    "monaco-editor": "^0.56.0",
    "react": "^18",
    "react-dom": "^18"
  }
}